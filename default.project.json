{
  "name": "rblx-scripts",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },
      "Tools": {
        "$className": "Folder"
      }
    },

    "ReplicatedFirst": {
      "Client": {
        "$path": "src/replicatedfirst"
      }
    },

    "ServerStorage": {
      "Modules": {
        "$path": "src/serverstorage",
        "$className": "Folder"
      }
    },

    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },

    "StarterGui": {
      "GUI": {
        "$path": "src/startergui"
      }
    },

    "StarterPack": {
      "Items": {
        "$path": "src/starterpack",
        "$className": "Folder"
      }
    },

    "StarterPlayer": {
      "$properties": {
        "CameraMode": "Classic"
      },
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        },
        "$path": "src/starterplayerscripts"
      },
      "StarterCharacterScripts": {
        "Character": {
          "$path": "src/character"
        }
      }
    },

    "Workspace": {
      "$properties": {
        "FilteringEnabled": true
      },
      "Baseplate": {
        "$className": "Part",
        "$properties": {
          "Anchored": true,
          "Color": [
            0.38823,
            0.37254,
            0.38823
          ],
          "Locked": true,
          "Position": [
            0,
            -10,
            0
          ],
          "Size": [
            512,
            20,
            512
          ]
        }
      }
    },
    "Lighting": {
      "$properties": {
        "Ambient": [
          0,
          0,
          0
        ],
        "Brightness": 2,
        "GlobalShadows": true,
        "Outlines": false,
        "Technology": "Voxel",
        "FogStart": 0,
        "FogEnd": 100,
        "FogColor": [
          0,
          0,
          0
        ]
      }
    },
    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}